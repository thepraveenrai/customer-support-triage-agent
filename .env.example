# ==============================================================================
# PROJECT 2: CUSTOMER SUPPORT TRIAGE AGENT - CONFIGURATION
# ==============================================================================

# LLM Provider Configuration
# Supported options:
# 1. "openrouter" - Recommended: access any model (GPT-4o, Claude 3.5 Sonnet, Llama 3.3, etc.)
# 2. "openai"     - Direct OpenAI API
# 3. "mock"       - Zero-cost deterministic mock LLM for offline testing & demos
LLM_PROVIDER=openrouter

# ==============================================================================
# 1. OpenRouter Configuration (Recommended)
# ==============================================================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_APP_NAME=Customer Support Triage Agent

# OpenRouter Models:
# - openai/gpt-4o-mini (fast & economical)
# - anthropic/claude-3.5-sonnet (exceptional reasoning)
# - meta-llama/llama-3.3-70b-instruct
# - mistralai/mistral-large-2407
MODEL_NAME=openai/gpt-4o-mini
MODEL_TEMPERATURE=0.0

# ==============================================================================
# 2. Direct OpenAI Configuration (Alternative)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================================================
# 3. Human-in-the-Loop Thresholds
# ==============================================================================
REFUND_APPROVAL_THRESHOLD_USD=50.0

# ==============================================================================
# 4. Server Configuration (for FastAPI)
# ==============================================================================
API_HOST=127.0.0.1
API_PORT=8000

# ==============================================================================
# 5. LangSmith Tracing (Optional - recommended for Lecture 8 of course)
# ==============================================================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=project-2-support-triage
